<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_home_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="HomeCard.Pale">
        <item name="android:background">@drawable/bg_home_pale</item>
    </style>

    <style name="HomeCard.Clickable">
        <item name="android:clickable">true</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="HomeText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HomeSectionTitle" parent="HomeText">
        <item name="android:layout_marginTop">23dp</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textColor">@color/home_ink</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="HomeCardTitle" parent="HomeText">
        <item name="android:textColor">@color/home_ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="HomeBody" parent="HomeText">
        <item name="android:textColor">@color/home_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="HomeKicker" parent="HomeText">
        <item name="android:textColor">@color/home_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <style name="HomeAction" parent="HomeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">@drawable/bg_home_action</item>
        <item name="android:clickable">true</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">13dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/home_accent</item>
        <item name="android:textFontWeight">750</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
