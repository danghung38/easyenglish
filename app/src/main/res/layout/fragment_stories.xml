<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/story_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_story_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stories"
            app:tint="@color/story_control_ink" />

        <TextView
            style="@style/StoryText"
            android:layout_width="0dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:text="@string/txt_stories_intro"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/storyLevels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        app:chipSpacingHorizontal="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStoryAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:fontFamily="@font/font_inter"
            android:text="@string/txt_story_all"
            android:textColor="@color/story_control_ink"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/story_level_background" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStoryBeginner"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:fontFamily="@font/font_inter"
            android:text="@string/txt_story_beginner"
            android:textColor="@color/story_beginner_ink"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/story_level_background" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStoryIntermediate"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:fontFamily="@font/font_inter"
            android:text="@string/txt_story_intermediate"
            android:textColor="@color/story_intermediate_ink"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/story_level_background" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStoryAdvanced"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:fontFamily="@font/font_inter"
            android:text="@string/txt_story_advanced"
            android:textColor="@color/story_advanced_ink"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/story_level_background" />
    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="18dp"
            android:paddingBottom="10dp" />

        <ProgressBar
            android:id="@+id/pbStories"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/story_control_ink"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lnStoriesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStoriesStatus"
                style="@style/StoryText"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnRetryStories"
                style="@style/StoryAction"
                android:layout_marginTop="12dp"
                android:text="@string/txt_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
