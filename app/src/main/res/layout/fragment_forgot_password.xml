<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:padding="7dp"
                android:src="@drawable/ic_back"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="56dp"
                android:fontFamily="@font/font_inter"
                android:text="@string/app_name"
                android:textColor="@color/color_app"
                android:textFontWeight="800"
                android:textSize="22sp" />
        </TableRow>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="25dp">

            <ImageView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginTop="42dp"
                android:src="@drawable/ic_lock_reset"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/font_inter"
                android:text="@string/txt_forgot_title"
                android:textColor="@color/color_text_app"
                android:textFontWeight="800"
                android:textSize="26sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:fontFamily="@font/font_inter"
                android:text="@string/txt_forgot_des"
                android:textColor="@color/color_des_login"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_edt_login"
                android:hint="@string/txt_des_mail"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="18dp"
                android:textColor="@color/color_text_app"
                android:textColorHint="@color/color_splash_des"
                android:textSize="16sp"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_btn_login"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_inter"
                android:gravity="center"
                android:text="@string/txt_send_reset_otp"
                android:textColor="@android:color/white"
                android:textFontWeight="730"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
