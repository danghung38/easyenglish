<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/HomeSectionTitle"
        android:text="@string/home_daily_title" />

    <LinearLayout
        style="@style/HomeCard.Pale"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/home_word_surface"
        android:orientation="vertical">

        <TextView
            style="@style/HomeKicker"
            android:textColor="@color/home_word_ink"
            android:text="@string/home_word_label" />

        <TextView
            android:id="@+id/tvDailyWord"
            style="@style/HomeCardTitle"
            android:layout_marginTop="4dp"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/tvDailyDefinition"
            style="@style/HomeBody"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDailyExample"
            style="@style/HomeBody"
            android:layout_marginTop="8dp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/btnTranslateWord"
            style="@style/HomeAction"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/home_word_action"
            android:text="@string/home_translate_word"
            android:textColor="@color/home_word_ink" />
    </LinearLayout>

    <LinearLayout
        style="@style/HomeCard"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/home_quiz_surface"
        android:orientation="vertical">

        <TextView
            style="@style/HomeCardTitle"
            android:text="@string/home_quiz_title" />

        <TextView
            android:id="@+id/tvQuizPrompt"
            style="@style/HomeBody"
            android:layout_marginTop="6dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quizChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/tvQuizFeedback"
            style="@style/HomeBody"
            android:layout_marginTop="5dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        style="@style/HomeSectionTitle"
        android:text="@string/home_tools_title" />

    <LinearLayout
        style="@style/HomeCard.Pale"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/home_story_surface"
        android:clipToOutline="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btnFeaturedStory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivFeaturedStoryCover"
                android:layout_width="94dp"
                android:layout_height="108dp"
                android:background="@drawable/bg_home_icon"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HomeKicker"
                    android:text="@string/home_story_label"
                    android:textColor="@color/home_story_ink" />

                <TextView
                    android:id="@+id/tvFeaturedStoryTitle"
                    style="@style/HomeCardTitle"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvFeaturedStoryTranslation"
                    style="@style/HomeBody"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvFeaturedStoryDetails"
                    style="@style/HomeBody"
                    android:layout_marginTop="7dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnBrowseStories"
            style="@style/HomeAction"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/home_story_action"
            android:text="@string/home_browse_stories"
            android:textColor="@color/home_story_ink" />
    </LinearLayout>

    <LinearLayout
        style="@style/HomeCard"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/home_exam_surface"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFeaturedTitle"
            style="@style/HomeCardTitle"
            android:text="@string/home_featured_default_title" />

        <TextView
            android:id="@+id/tvFeaturedDetails"
            style="@style/HomeBody"
            android:layout_marginTop="6dp"
            android:text="@string/home_featured_default_details" />

        <TextView
            android:id="@+id/btnFeatured"
            style="@style/HomeAction"
            android:layout_marginTop="8dp"
            android:text="@string/home_browse_exams" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnLearn"
        style="@style/HomeCard.Clickable"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/home_learn_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_home_icon"
            android:backgroundTint="@color/home_learn_action"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_vocabulary"
            app:tint="@color/home_learn_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/HomeCardTitle"
                android:text="@string/home_learn_title"
                android:textSize="16sp" />

            <TextView
                style="@style/HomeBody"
                android:layout_marginTop="2dp"
                android:text="@string/home_learn_details"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_home_arrow"
            app:tint="@color/home_learn_ink" />
    </LinearLayout>
</LinearLayout>
