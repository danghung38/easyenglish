<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvTwoFactorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_inter"
                android:gravity="center"
                android:text="@string/txt_2fa_setup_title"
                android:textColor="@color/color_app"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/txt_2fa_setup_description"
                android:textColor="@color/color_splash_des"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/txt_2fa_qr_description"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_security_code" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/txt_2fa_secret_label"
                android:textColor="@color/color_text_profile"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edt_register"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvSecretKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/color_text_app"
                    android:textSize="16sp"
                    tools:text="JBSWY3DPEHPK3PXP" />

                <TextView
                    android:id="@+id/btnCopySecret"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:text="@string/txt_copy"
                    android:textColor="@color/color_app"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtTwoFactorCode"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_edt_register"
                android:gravity="center"
                android:letterSpacing="0.25"
                android:fontFamily="@font/font_inter"
                android:hint="@string/txt_2fa_code_hint"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="@color/color_text_app"
                android:textColorHint="@color/color_splash_des"
                android:textSize="16sp"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/btnVerifyTwoFactor"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_login"
                android:gravity="center"
                android:textSize="14sp"
                android:text="@string/txt_2fa_confirm_enable"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancelTwoFactor"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/txt_cancel"
                android:textSize="14sp"
                android:textColor="@color/color_splash_des"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
