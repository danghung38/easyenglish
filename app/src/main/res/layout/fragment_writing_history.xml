<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:padding="7dp"
            android:src="@drawable/ic_back"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="56dp"
            android:layout_weight="1"
            android:fontFamily="@font/font_inter"
            android:gravity="center"
            android:text="@string/txt_writing_history"
            android:textColor="@color/color_app"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:ignore="TextSizeCheck" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWritingResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:scrollbars="none"
        tools:listitem="@layout/item_writing_history" />

    <TextView
        android:id="@+id/tvEmptyWritingHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/font_inter"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/txt_no_writing_results"
        android:textColor="@color/color_splash_des"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
