<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@color/white"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:background="#EBEBEB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="13dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSkillName"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_skill"
                    android:fontFamily="@font/font_inter"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/txt_listening"
                    android:textColor="@color/white"
                    android:textFontWeight="600"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/font_inter"
                    android:text="@string/txt_band"
                    android:textColor="@color/color_splash_des"
                    android:textFontWeight="400"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBandScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_inter"
                    android:gravity="center"
                    android:text="@string/txt_band_score"
                    android:textColor="@color/color_app"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:text="@string/txt_band"
                    android:textColor="@color/color_splash_des"
                    android:textSize="12sp" />

            </LinearLayout>

        </TableRow>

    </LinearLayout>

</androidx.cardview.widget.CardView>
